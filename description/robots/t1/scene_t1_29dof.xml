<mujoco model="t1 scene">
  <include file="t1_29dof.xml"/>

  <asset>
    <!-- Materials for visualization axes -->
    <material name="x_axis" rgba="1 0 0 0.8"/>  <!-- Red for X -->
    <material name="y_axis" rgba="0 1 0 0.8"/>  <!-- Green for Y -->
    <material name="z_axis" rgba="0 0 1 0.8"/>  <!-- Blue for Z -->
    <material name="cube_base" rgba="0.7 0.7 0.7 0.5"/>  <!-- Gray for cube base -->
  </asset>

  <worldbody>
    <!-- Left End-Effector Visualization -->
    <body name="left_ee_viz" mocap="true">
      <!-- Base cube -->
      <geom name="left_ee_cube" type="box" size="0.02 0.02 0.02" material="cube_base"/>
      <!-- X-axis (Red) -->
      <geom name="left_ee_x_axis" type="cylinder" size="0.005 0.05" pos="0.025 0 0" 
            quat="0.707107 0 0.707107 0" material="x_axis"/>
      <!-- Y-axis (Green) -->
      <geom name="left_ee_y_axis" type="cylinder" size="0.005 0.05" pos="0 0.025 0" 
            quat="0.707107 -0.707107 0 0" material="y_axis"/>
      <!-- Z-axis (Blue) -->
      <geom name="left_ee_z_axis" type="cylinder" size="0.005 0.05" pos="0 0 0.025" 
            quat="1 0 0 0" material="z_axis"/>
      <!-- Axis labels using small spheres -->
      <geom name="left_ee_x_label" type="sphere" size="0.008" pos="0.05 0 0" rgba="1 0 0 1"/>
      <geom name="left_ee_y_label" type="sphere" size="0.008" pos="0 0.05 0" rgba="0 1 0 1"/>
      <geom name="left_ee_z_label" type="sphere" size="0.008" pos="0 0 0.05" rgba="0 0 1 1"/>
    </body>

    <!-- Right End-Effector Visualization -->
    <body name="right_ee_viz" mocap="true">
      <!-- Base cube -->
      <geom name="right_ee_cube" type="box" size="0.02 0.02 0.02" material="cube_base"/>
      <!-- X-axis (Red) -->
      <geom name="right_ee_x_axis" type="cylinder" size="0.005 0.05" pos="0.025 0 0" 
            quat="0.707107 0 0.707107 0" material="x_axis"/>
      <!-- Y-axis (Green) -->
      <geom name="right_ee_y_axis" type="cylinder" size="0.005 0.05" pos="0 0.025 0" 
            quat="0.707107 -0.707107 0 0" material="y_axis"/>
      <!-- Z-axis (Blue) -->
      <geom name="right_ee_z_axis" type="cylinder" size="0.005 0.05" pos="0 0 0.025" 
            quat="1 0 0 0" material="z_axis"/>
      <!-- Axis labels using small spheres -->
      <geom name="right_ee_x_label" type="sphere" size="0.008" pos="0.05 0 0" rgba="1 0 0 1"/>
      <geom name="right_ee_y_label" type="sphere" size="0.008" pos="0 0.05 0" rgba="0 1 0 1"/>
      <geom name="right_ee_z_label" type="sphere" size="0.008" pos="0 0 0.05" rgba="0 0 1 1"/>
    </body>
  </worldbody>

